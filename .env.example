# Mandala environment configuration.
#
# Copy to `.env` and edit. Variables already set in your shell always win over
# this file. The API reads it on startup (backend/config.py) and the UI proxy
# reads it through dotenv (server.ts).

# --- Copilot (local Ollama) -------------------------------------------------
# Ollama model tag that answers Copilot chats. The UI only claims a model when
# Ollama is reachable and this tag is actually pulled.
MANDALA_COPILOT_MODEL=qwen3.5:b
# OpenAI-compatible base URL of the local Ollama instance.
MANDALA_OLLAMA_URL=http://localhost:11434/v1

# --- Telemetry --------------------------------------------------------------
# Seconds between samples of the single shared telemetry sampler (min 0.05).
MANDALA_TELEMETRY_INTERVAL=1.0

# --- API --------------------------------------------------------------------
# Origin the UI proxy forwards /api and /ws traffic to.
MANDALA_API_URL=http://127.0.0.1:8000

# --- Auth session cookie ----------------------------------------------------
# 1 marks the mandala_session cookie `Secure`, which browsers only send over
# HTTPS. Leave at 0 for http://localhost development.
MANDALA_COOKIE_SECURE=0
